# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173

# MongoDB (optional: messages are stored when set, e.g. MongoDB Atlas)
MONGODB_URI=

# Email (Gmail: enable 2-step verification, then create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=shrestha712sujan@gmail.com
SMTP_PASS=
MAIL_TO=shrestha712sujan@gmail.com

# Max contact messages per IP per hour
CONTACT_RATE_LIMIT=5
